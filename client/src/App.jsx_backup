}


/* MAIN */

.main {
  margin-left: 325px;
  width: calc(100% - 325px);
  min-height: 100vh;
}

.topbar {
  height: 145px;
  padding: 35px 55px;
  border-bottom: 1px solid #242930;
  display: flex;
  justify-content: space-between;
