import { useState } from "react";

function App() {
  const [loggedIn, setLoggedIn] = useState(false);
  const [loginType, setLoginType] = useState(null);
  const [activePage, setActivePage] = useState("Dashboard");

  const [userDestination, setUserDestination] = useState("");
  const [userBudget, setUserBudget] = useState("2000");
  const [userRating, setUserRating] = useState("0");
  const [userDistance, setUserDistance] = useState("10");
  const [userAmenities, setUserAmenities] = useState([]);
  const [userPreferences, setUserPreferences] = useState(null);

  const toggleAmenity = (name) => {
    setUserAmenities((current) =>
      current.includes(name)
        ? current.filter((item) => item !== name)
        : [...current, name]
    );
  };

  const findMyStay = () => {
    if (!userDestination) {
      alert("Please select a destination.");
      return;
    }

    setUserPreferences({
      destination: userDestination,
      budget: userBudget,
      rating: userRating,
      distance: userDistance,
      amenities: userAmenities,
    });

    setActivePage("Hotels");
  };

  // ---------------- LOGIN ----------------

  if (!loggedIn) {
    return (
      <>
        <style>{styles}</style>

        <div className="login-page">
          <div className="login-card">

            <div className="logo-box">S</div>

            <h1>StaySphere</h1>

            <p className="subtitle">HOTEL INTELLIGENCE</p>

            {/* LOGIN TYPE SELECTION */}

            {!loginType && (
              <>
                <div className="login-heading">
                  Welcome to StaySphere
                </div>

                <p className="login-text">
                  Choose how you want to continue
                </p>

                <button
                  className="login-button"
                  onClick={() => setLoginType("user")}
                >
                  👤 User Login →
                </button>

                <button
                  className="login-button"
                  onClick={() => setLoginType("admin")}
                  style={{ marginTop: "12px" }}
                >
                  🔐 Admin Login →
                </button>
              </>
            )}

            {/* USER LOGIN */}

            {loginType === "user" && (
              <>
                <div className="login-heading">
                  User Login
                </div>

                <p className="login-text">
                  Sign in to find your perfect stay
                </p>

                <label>Email</label>

                <input
                  type="text"
                  placeholder="Enter email"
                  defaultValue="user@gmail.com"
                />

                <label>Password</label>

                <input
                  type="password"
                  placeholder="Enter password"
                  defaultValue="user123"
                />

                <button
                  className="login-button"
                  onClick={() => setLoggedIn(true)}
                >
                  Login →
                </button>

                <p className="demo-text">
                  Demo credentials: user@gmail.com / user123
                </p>

                <button
                  onClick={() => setLoginType(null)}
                  style={{
                    marginTop: "10px",
                    background: "none",
                    border: "none",
                    cursor: "pointer",
                  }}
                >
                  ← Back
                </button>
              </>
            )}

            {/* ADMIN LOGIN */}

            {loginType === "admin" && (
              <>
                <div className="login-heading">
                  Admin Login
                </div>

                <p className="login-text">
                  Sign in to manage your hotel properties
                </p>

                <label>Username</label>

                <input
                  type="text"
                  placeholder="Enter username"
                  defaultValue="admin"
                />

                <label>Password</label>

                <input
                  type="password"
                  placeholder="Enter password"
                  defaultValue="admin123"
                />

                <button
                  className="login-button"
                  onClick={() => setLoggedIn(true)}
                >
                  Login →
                </button>

                <p className="demo-text">
                  Demo credentials: admin / admin123
                </p>

                <button
                  onClick={() => setLoginType(null)}
                  style={{
                    marginTop: "10px",
                    background: "none",
                    border: "none",
                    cursor: "pointer",
                  }}
                >
                  ← Back
                </button>
              </>
            )}

          </div>
        </div>
      </>
    );
  }

  // ---------------- USER HOME ----------------

  if (loginType === "user") {
    return (
      <>
        <style>{styles}</style>

        <div className="user-booking-page">

          {/* NAVBAR */}

          <nav className="user-navbar">

            <div className="user-brand">

              <div className="user-logo">
                S
              </div>

              <div>
                <h2>StaySphere</h2>
                <span>HOTEL INTELLIGENCE</span>
              </div>

            </div>

            <button
              className="user-logout"
              onClick={() => {
                setLoggedIn(false);
                setLoginType(null);
              }}
            >
              Logout
            </button>

          </nav>

          {/* MAIN */}

          <main className="user-main">

            {/* HERO */}

            <div className="user-hero">

              <p className="user-label">
                SMART HOTEL DISCOVERY
              </p>

              <h1>
                Find your
                <span> perfect stay.</span>
              </h1>

              <p>
                Tell us where you're going and what you need.
                StaySphere will find the best hotel for you.
              </p>

            </div>

            {/* SEARCH CARD */}

            <div className="hotel-search-card">

              <div className="search-card-heading">

                <p className="user-label">
                  PLAN YOUR STAY
                </p>

                <h2>
                  Where do you want to go?
                </h2>

                <p>
                  Select your preferences and we'll recommend
                  the best match.
                </p>

              </div>

              {/* DESTINATION */}

              <div className="form-group destination-group">

                <label>
                  📍 Destination
                </label>

                <select
                  value={userDestination}
                  onChange={(e) =>
                    setUserDestination(e.target.value)
                  }
                >

                  <option value="">
                    Select your destination
                  </option>

                  <option value="Guntur">
                    Guntur
                  </option>

                  <option value="Vijayawada">
                    Vijayawada
                  </option>

                  <option value="Hyderabad">
                    Hyderabad
                  </option>

                </select>

              </div>

              {/* FILTERS */}

              <div className="filter-row">

                <div className="form-group">

                  <label>
                    💰 Maximum Budget
                  </label>

                  <select
                    value={userBudget}
                    onChange={(e) =>
                      setUserBudget(e.target.value)
                    }
                  >

                    <option value="1000">
                      ₹1,000
                    </option>

                    <option value="2000">
                      ₹2,000
                    </option>

                    <option value="3000">
                      ₹3,000
                    </option>

                    <option value="4000">
                      ₹4,000
                    </option>

                    <option value="5000">
                      ₹5,000
                    </option>

                    <option value="10000">
                      ₹10,000
                    </option>

                  </select>

                </div>

                <div className="form-group">

                  <label>
                    ⭐ Minimum Rating
                  </label>

                  <select
                    value={userRating}
                    onChange={(e) =>
                      setUserRating(e.target.value)
                    }
                  >

                    <option value="0">
                      Any Rating
                    </option>

                    <option value="3">
                      3+ ⭐
                    </option>

                    <option value="4">
                      4+ ⭐
                    </option>

                    <option value="4.5">
                      4.5+ ⭐
                    </option>

                  </select>

                </div>

                <div className="form-group">

                  <label>
                    📍 Distance
                  </label>

                  <select
                    value={userDistance}
                    onChange={(e) =>
                      setUserDistance(e.target.value)
                    }
                  >

                    <option value="10">
                      Any Distance
                    </option>

                    <option value="2">
                      Within 2 km
                    </option>

                    <option value="5">
                      Within 5 km
                    </option>

                    <option value="10">
                      Within 10 km
                    </option>

                  </select>

                </div>

              </div>

              {/* AMENITIES */}

              <div className="amenities-section">

                <div className="amenities-heading">

                  <div>

                    <label>
                      Amenities
                    </label>

                    <span>
                      Select what matters to you
                    </span>

                  </div>

                </div>

                <div className="amenities-grid">

                  {[
                    ["WiFi", "📶"],
                    ["AC", "❄️"],
                    ["Pool", "🏊"],
                    ["Parking", "🚗"],
                    ["Breakfast", "🍳"],
                    ["Gym", "🏋️"],
                  ].map(([name, icon]) => (

                    <label
                      className={`amenity-card ${
                        userAmenities.includes(name)
                          ? "selected"
                          : ""
                      }`}
                      key={name}
                    >

                      <input
                        type="checkbox"
                        checked={userAmenities.includes(name)}
                        onChange={() =>
                          toggleAmenity(name)
                        }
                      />

                      <span>
                        {icon}
                      </span>

                      <strong>
                        {name}
                      </strong>

                    </label>

                  ))}

                </div>

              </div>

              {/* FIND BUTTON */}

              <button
                className="find-stay-button"
                onClick={findMyStay}
              >
                🔍 Find My Stay
              </button>

            </div>

            {/* BENEFITS */}

            <div className="user-benefits">

              <div>

                <span>✦</span>

                <div>
                  <strong>
                    Smart Recommendations
                  </strong>

                  <p>
                    Hotels matched to your preferences
                  </p>
                </div>

              </div>

              <div>

                <span>⌖</span>

                <div>
                  <strong>
                    Best Locations
                  </strong>

                  <p>
                    Compare distance before booking
                  </p>
                </div>

              </div>

              <div>

                <span>₹</span>

                <div>
                  <strong>
                    Budget Friendly
                  </strong>

                  <p>
                    Find stays within your price range
                  </p>
                </div>

              </div>

            </div>

          </main>

        </div>
      </>
    );
  }

  // ---------------- ADMIN ----------------

  if (loginType === "admin") {
    return (
      <>
        <style>{styles}</style>

        <div className="admin-page">

          <h1>
            StaySphere Admin Dashboard
          </h1>

          <button
            onClick={() => {
              setLoggedIn(false);
              setLoginType(null);
            }}
          >
            Logout
          </button>

        </div>
      </>
    );
  }

  return null;
}

export default App;

  // ---------------- PAGE CONTENT ----------------

  const renderPage = () => {
    switch (activePage) {
      case "Dashboard":
        return <Dashboard setActivePage={setActivePage} />;

      case "Hotels":
        return <Hotels />;

      case "Bookings":
        return <Bookings />;

      case "Guests":
        return <Guests />;

      case "Analytics":
        return <Analytics />;

      case "Rooms":
        return <Rooms />;

      case "Staff":
        return <Staff />;

      default:
        return <Dashboard setActivePage={setActivePage} />;
    }
  };

  return (
    <>
      <style>{styles}</style>

      <div className="app">
        {/* SIDEBAR */}
        <aside className="sidebar">
          <div className="brand">
            <div className="logo-box small">S</div>

            <div>
              <h2>StaySphere</h2>
              <p>HOTEL INTELLIGENCE</p>
            </div>
          </div>

          <div className="menu-title">MAIN MENU</div>

          <NavItem
            icon="⌂"
            text="Dashboard"
            active={activePage === "Dashboard"}
            onClick={() => setActivePage("Dashboard")}
          />

          <NavItem
            icon="♧"
            text="Hotels"
            active={activePage === "Hotels"}
            onClick={() => setActivePage("Hotels")}
          />

          <NavItem
            icon="▣"
            text="Bookings"
            active={activePage === "Bookings"}
            onClick={() => setActivePage("Bookings")}
          />

          <NavItem
            icon="♙"
            text="Guests"
            active={activePage === "Guests"}
            onClick={() => setActivePage("Guests")}
          />

          <NavItem
            icon="◇"
            text="Analytics"
            active={activePage === "Analytics"}
            onClick={() => setActivePage("Analytics")}
          />

          <div className="menu-title management-title">
            MANAGEMENT
          </div>

          <NavItem
            icon="▤"
            text="Rooms"
            active={activePage === "Rooms"}
            onClick={() => setActivePage("Rooms")}
          />

          <NavItem
            icon="♟"
            text="Staff"
            active={activePage === "Staff"}
            onClick={() => setActivePage("Staff")}
          />

          <div className="sidebar-bottom">
            <div className="support">
              <strong>✦ Need assistance?</strong>
              <span>Contact support</span>
            </div>

            <div className="admin-profile">
              <div className="avatar">AD</div>

              <div>
                <strong>Admin</strong>
                <span>Hotel Manager</span>
              </div>

              <button
                className="logout"
                onClick={() => setLoggedIn(false)}
              >
                Logout
              </button>
            </div>
          </div>
        </aside>

        {/* MAIN AREA */}
        <main className="main">
          <header className="topbar">
            <div>
              <p className="date">MONDAY, SEPTEMBER 07, 2026</p>
              <h1>{activePage}</h1>
            </div>

            <div className="top-admin">
              <button className="notification">🔔</button>

              <div className="avatar">AD</div>

              <div>
                <strong>Admin</strong>
                <span>Manager</span>
              </div>
            </div>
          </header>

          <section className="content">{renderPage()}</section>
        </main>
      </div>
    </>
  );
}


// ---------------- NAV ITEM ----------------

function NavItem({ icon, text, active, onClick }) {
  return (
    <button
      className={`nav-item ${active ? "active" : ""}`}
      onClick={onClick}
    >
      <span className="nav-icon">{icon}</span>
      <span>{text}</span>
    </button>
  );
}


// ---------------- DASHBOARD ----------------

function Dashboard({ setActivePage }) {
  return (
    <div>
      <div className="welcome">
        <p>OVERVIEW</p>
        <h2>Good evening, Admin ✦</h2>
        <span>
          Here's what's happening across your properties today.
        </span>
      </div>

      <div className="stats-grid">
        <StatCard
          title="Total Revenue"
          value="₹8.42L"
          change="↑ 12.8% vs last month"
          icon="₹"
        />

        <StatCard
          title="Occupancy Rate"
          value="78.4%"
          change="186 of 237 rooms occupied"
          icon="◉"
          progress
        />

        <StatCard
          title="Today's Bookings"
          value="42"
          change="↑ 8.2% vs yesterday"
          icon="▣"
        />

        <StatCard
          title="Guest Satisfaction"
          value="4.8"
          change="★★★★★"
          icon="★"
        />
      </div>

      <div className="dashboard-grid">
        <div className="large-panel">
          <p className="section-label">PROPERTY MANAGEMENT</p>
          <h2>Manage your hotels</h2>

          <p className="panel-description">
            View hotel properties, room availability and locations
            from one place.
          </p>

          <button
            className="gold-button"
            onClick={() => setActivePage("Hotels")}
          >
            View Hotels →
          </button>
        </div>

        <div className="small-panel">
          <p className="section-label">TODAY</p>
          <h2>42</h2>

          <p className="panel-description">
            New bookings received today
          </p>

          <button
            className="outline-button"
            onClick={() => setActivePage("Bookings")}
          >
            View Bookings
          </button>
        </div>
      </div>

      <div className="activity-panel">
        <div className="panel-header">
          <div>
            <p className="section-label">RECENT ACTIVITY</p>
            <h2>Latest Activity</h2>
          </div>
        </div>

        <div className="activity-list">
          <Activity
            title="New booking received"
            description="Meridian Bay · Room 402"
            time="8 minutes ago"
          />

          <Activity
            title="Room marked available"
            description="Grand Horizon · Room 218"
            time="22 minutes ago"
          />

          <Activity
            title="New guest checked in"
            description="Royal Palm · Room 105"
            time="45 minutes ago"
          />
        </div>
      </div>
    </div>
  );
}


// ---------------- STAT CARD ----------------

function StatCard({ title, value, change, icon, progress }) {
  return (
    <div className="stat-card">
      <div className="stat-top">
        <span>{title}</span>
        <div className="stat-icon">{icon}</div>
      </div>

      <h2>{value}</h2>

      {progress && (
        <div className="progress">
          <div></div>
        </div>
      )}

      <p>{change}</p>
    </div>
  );
}


