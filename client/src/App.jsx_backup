    price: 2900,
    rating: 4.3,
    distance: 5.1,
    rooms: 14,
    available: true,
    amenities: ["WiFi", "Parking", "AC", "Breakfast"],
    image:
      "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1000&q=80",
    coordinates: [17.405, 78.475],
  },

  {
    name: "Hyderabad City Lodge",
    location: "Hyderabad",
    city: "Hyderabad",
    price: 1600,
    rating: 3.8,
    distance: 1.3,
    rooms: 20,
    available: true,
    amenities: ["WiFi", "AC"],
    image:
      "https://images.unsplash.com/photo-1595576508898-0ad5c879a061?auto=format&fit=crop&w=1000&q=80",
    coordinates: [17.415, 78.505],
  },

  {
    name: "Hyderabad Budget Inn",
    location: "Hyderabad",
    city: "Hyderabad",
    price: 1100,
    rating: 3.5,
    distance: 2.2,
    rooms: 30,
    available: true,
    amenities: ["WiFi"],
    image:
      "https://images.unsplash.com/photo-1540518614846-7eded433c457?auto=format&fit=crop&w=1000&q=80",
    coordinates: [17.425, 78.525],
  },
];
  // User search preferences
  const hasUserSearch = !!userPreferences;

  const userDestination = userPreferences?.destination || "Guntur";
  const userMaxPrice = Number(userPreferences?.budget) || 10000;
  const userMinRating = Number(userPreferences?.rating) || 0;
  const userMaxDistance = Number(userPreferences?.distance) || 10;
  const userAmenities = userPreferences?.amenities || [];
     
   

  const [destination, setDestination] = useState("Guntur");
  const [maxPrice, setMaxPrice] = useState(10000);
  const [maxDistance, setMaxDistance] = useState(10);
  const [minRating, setMinRating] = useState(0);
  const [amenity, setAmenity] = useState("All");
  const [availableOnly, setAvailableOnly] = useState(false);
  const [selectedHotel, setSelectedHotel] = useState(null);
  const [searched, setSearched] = useState(true);

    const filteredHotels = hotels
    .filter((hotel) =>
      hotel.city === (hasUserSearch ? userDestination : destination)
    )
    .filter((hotel) =>
      hotel.price <= (hasUserSearch ? userMaxPrice : maxPrice)
    )
    .filter((hotel) =>
      hotel.distance <= (hasUserSearch ? userMaxDistance : maxDistance)
    )
    .filter((hotel) =>
      hotel.rating >= (hasUserSearch ? userMinRating : minRating)
    )
    .filter((hotel) => {
      if (!hasUserSearch || userAmenities.length === 0) return true;

      return userAmenities.every((amenity) =>
        hotel.amenities.includes(amenity)
      );
    })
    .filter(
  (hotel) =>
    hasUserSearch ||
    amenity === "All" ||
    hotel.amenities.includes(amenity)
)
    .filter((hotel) => !availableOnly || hotel.available)
    .map((hotel) => {
      let score = 0;

      // Price score - 25%
      score += Math.max(0, 25 - (hotel.price / maxPrice) * 25);

      // Distance score - 20%
      score += Math.max(
        0,
        20 - (hotel.distance / maxDistance) * 20
      );

      // Rating score - 25%
      score += (hotel.rating / 5) * 25;

      // Amenities score - 15%
      score += Math.min(hotel.amenities.length / 5, 1) * 15;

      // Availability score - 15%
      score += hotel.available ? 15 : 0;

      return {
        ...hotel,
        matchScore: Math.round(score),
      };
    })
    .sort((a, b) => b.matchScore - a.matchScore);

  const currentHotel =
  selectedHotel ||
  filteredHotels[0] ||
  null;

  const destinationCoordinates = {
  Guntur: [16.3067, 80.4365],
  Vijayawada: [16.5062, 80.648],
  Hyderabad: [17.385, 78.4867],
};
  const mapCoordinates = hasUserSearch
  ? currentHotel?.coordinates || destinationCoordinates[userDestination]
  : currentHotel?.coordinates || destinationCoordinates[destination];

const mapUrl = mapCoordinates
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${
      mapCoordinates[1] - 0.06
    }%2C${mapCoordinates[0] - 0.06}%2C${
      mapCoordinates[1] + 0.06
    }%2C${mapCoordinates[0] + 0.06}&layer=mapnik${
      currentHotel
        ? `&marker=${mapCoordinates[0]}%2C${mapCoordinates[1]}`
        : ""
    }`
  : "";

  const handleSearch = () => {
    setSearched(true);
    setSelectedHotel(null);
  };

  return (
    <div className="staysphere-hotels">

      {/* SEARCH HEADER */}
      <div className="recommendation-header">
        <div>
          <p className="section-label">STAYSPHERE RECOMMENDATION ENGINE</p>
          <h2>Find your perfect stay</h2>
          <p>
            Choose your destination and preferences. StaySphere will
            recommend hotels based on price, distance, rating,
            amenities and room availability.
          </p>
        </div>
      </div>

      {/* SEARCH BOX */}
      <div className="search-panel">

        <div className="search-title">
          <span>📍</span>
          <div>
            <strong>Where do you want to stay?</strong>
            <small>Select your destination</small>
          </div>
        </div>

        <select
          value={destination}
          onChange={(e) => setDestination(e.target.value)}
          className="destination-select"
        >
          <option value="Guntur">Guntur</option>
          <option value="Vijayawada">Vijayawada</option>
          <option value="Hyderabad">Hyderabad</option>
        </select>

        <button className="gold-button search-button" onClick={handleSearch}>
          🔍 Find Hotels
        </button>
      </div>

      {/* FILTERS */}
      <div className="filter-panel">

        <div className="filter-heading">
          <div>
            <p className="section-label">FILTERS</p>
            <h3>Refine your search</h3>
          </div>

          <button
            className="clear-filters"
            onClick={() => {
              setMaxPrice(10000);
              setMaxDistance(10);
              setMinRating(0);
              setAmenity("All");
              setAvailableOnly(false);
            }}
          >
            Clear filters
          </button>
        </div>

        <div className="filters-grid">

          {/* PRICE */}
          <div className="filter-box">
            <label>💰 Maximum Price</label>

            <select
              value={maxPrice}
              onChange={(e) => setMaxPrice(Number(e.target.value))}
            >
              <option value={2000}>₹2,000 / night</option>
              <option value={3000}>₹3,000 / night</option>
              <option value={5000}>₹5,000 / night</option>
              <option value={7500}>₹7,500 / night</option>
              <option value={10000}>₹10,000 / night</option>
            </select>
          </div>

          {/* DISTANCE */}
          <div className="filter-box">
            <label>📍 Distance</label>

            <select
              value={maxDistance}
              onChange={(e) => setMaxDistance(Number(e.target.value))}
            >
              <option value={1}>Within 1 km</option>
              <option value={3}>Within 3 km</option>
              <option value={5}>Within 5 km</option>
              <option value={10}>Within 10 km</option>
            </select>
          </div>

          {/* RATING */}
          <div className="filter-box">
            <label>⭐ Minimum Rating</label>

            <select
              value={minRating}
              onChange={(e) => setMinRating(Number(e.target.value))}
            >
              <option value={0}>Any rating</option>
              <option value={3.5}>3.5+</option>
              <option value={4}>4.0+</option>
              <option value={4.5}>4.5+</option>
            </select>
          </div>

          {/* AMENITIES */}
          <div className="filter-box">
            <label>🛜 Amenities</label>

            <select
              value={amenity}
              onChange={(e) => setAmenity(e.target.value)}
            >
              <option value="All">All amenities</option>
              <option value="WiFi">WiFi</option>
              <option value="Pool">Swimming Pool</option>
              <option value="Parking">Parking</option>
              <option value="AC">AC</option>
              <option value="Breakfast">Breakfast</option>
              <option value="Gym">Gym</option>
            </select>
          </div>

          {/* AVAILABILITY */}
          <div className="availability-filter">
            <label>
              <input
                type="checkbox"
                checked={availableOnly}
                onChange={(e) => setAvailableOnly(e.target.checked)}
              />
              <span>🛏 Show available rooms only</span>
            </label>
          </div>

        </div>
      </div>

      {/* RESULTS */}
      <div className="results-layout">

        {/* HOTEL RESULTS */}
        <div className="results-left">

          <div className="results-heading">
            <div>
              <p className="section-label">RECOMMENDED FOR YOU</p>
              <h2>Hotels in {destination}</h2>
            </div>

            <span className="result-count">
              {filteredHotels.length} result
              {filteredHotels.length !== 1 ? "s" : ""}
            </span>
          </div>

          {filteredHotels.length === 0 ? (
            <div className="no-results">
              <div>🏨</div>
              <h3>No hotels found</h3>
              <p>
                Try increasing your price, distance or changing your
                filters.
              </p>
            </div>
          ) : (
            filteredHotels.map((hotel, index) => (
              <div
                className={`recommendation-card ${
                  selectedHotel?.name === hotel.name ? "selected-hotel" : ""
                }`}
                key={hotel.name}
                onClick={() => setSelectedHotel(hotel)}
              >

                <img src={hotel.image} alt={hotel.name} />

                <div className="recommendation-info">

                  <div className="recommendation-top">
                    <div>
                      {index === 0 && (
                        <span className="best-match">
                          🏆 BEST MATCH
                        </span>
                      )}

                      <h3>{hotel.name}</h3>

                      <p className="hotel-location">
                        📍 {hotel.location} · {hotel.distance} km away
                      </p>
                    </div>

                    <div className="match-score">
                      <strong>{hotel.matchScore}%</strong>
                      <span>Match</span>
                    </div>
                  </div>

                  <div className="recommendation-details">

                    <div>
                      <span className="detail-label">RATING</span>
                      <strong>⭐ {hotel.rating}</strong>
                    </div>

                    <div>
                      <span className="detail-label">PRICE</span>
                      <strong>₹{hotel.price.toLocaleString()}</strong>
                      <small>/night</small>
                    </div>

                    <div>
                      <span className="detail-label">ROOMS</span>
                      <strong>{hotel.rooms} available</strong>
                    </div>

                  </div>

                  <div className="amenity-list">
                    {hotel.amenities.map((item) => (
                      <span key={item}>✓ {item}</span>
                    ))}
                  </div>

                  <div className="recommendation-bottom">
                    <span className="available-text">
                      ● {hotel.rooms} rooms available
                    </span>

                    <button
                      className="view-hotel-button"
                      onClick={(e) => {
                        e.stopPropagation();
                        setSelectedHotel(hotel);
                      }}
                    >
                      View on Map →
                    </button>
                  </div>

                </div>
              </div>
            ))
          )}
        </div>

        {/* MAP */}
        <div className="recommendation-map">

          <div className="map-heading">
            <div>
              <p className="section-label">LOCATION</p>
              <h2>{currentHotel?.name || destination}</h2>
              <p>
                📍 {currentHotel?.location || destination}
              </p>
            </div>

            <span className="map-live">● LIVE MAP</span>
          </div>

          {currentHotel ? (
            <iframe
              title="StaySphere Hotel Map"
              src={mapUrl}
            ></iframe>
          ) : (
            <div className="empty-map">
              Select a hotel to view its location
            </div>
          )}

          {currentHotel && (
            <div className="map-hotel-info">
              <strong>{currentHotel.name}</strong>
              <span>
                ⭐ {currentHotel.rating} · ₹
                {currentHotel.price.toLocaleString()}/night
              </span>
            </div>
          )}

        </div>

      </div>

    </div>
  );
}


// ---------------- BOOKINGS ----------------

function Bookings() {
  const bookings = [
    ["Rahul Kumar", "Meridian Bay", "01 Sep 2026", "Confirmed", "₹8,500"],
    ["Ananya Reddy", "Grand Horizon", "02 Sep 2026", "Pending", "₹6,200"],
    ["Arjun Sharma", "Royal Palm", "03 Sep 2026", "Confirmed", "₹4,800"],
    ["Sneha Rao", "Meridian Bay", "04 Sep 2026", "Confirmed", "₹9,200"],
  ];

  return (
    <div>
      <PageTitle
        label="RESERVATIONS"
        title="Bookings"
        description="Manage all hotel reservations in one place."
      />

      <div className="table-panel">
        <table>
          <thead>
            <tr>
              <th>GUEST</th>
              <th>PROPERTY</th>
              <th>DATE</th>
              <th>STATUS</th>
              <th>AMOUNT</th>
            </tr>
          </thead>

          <tbody>
            {bookings.map((booking, index) => (
              <tr key={index}>
                <td>{booking[0]}</td>
                <td>{booking[1]}</td>
                <td>{booking[2]}</td>
                <td>
                  <span
                    className={
                      booking[3] === "Confirmed"
                        ? "confirmed"
                        : "pending"
                    }
                  >
                    {booking[3]}
                  </span>
                </td>
                <td>{booking[4]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}


