}

.welcome span,
.page-title > p:last-child,
.page-heading p,
.panel-description {
  color: #78818c;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.stat-card,
.large-panel,
.small-panel,
.activity-panel,
.table-panel,
.analytics-card,
.guest-card,
.room-card,
.staff-card {
