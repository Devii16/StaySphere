}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #8a929d;
  font-size: 13px;
}

.stat-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: #1d2025;
  color: #e2b64a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-card h2 {
  font-size: 36px;
  font-weight: 500;
  margin: 28px 0 15px;
}

.stat-card p {
  color: #7f8994;
  font-size: 12px;
}

.progress,
.big-progress {
  height: 7px;
  background: #2c3138;
  border-radius: 10px;
  overflow: hidden;
}

.progress div,
.big-progress div {
  height: 100%;
  width: 78.4%;
  background: #d5a83c;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  margin-top: 28px;
}

.large-panel,
.small-panel {
  padding: 35px;
  min-height: 230px;
}

.large-panel h2,
.small-panel h2 {
  font-size: 27px;
  font-weight: 500;
  margin: 0 0 12px;
}

.gold-button,
.outline-button {
  border-radius: 10px;
  padding: 13px 20px;
  cursor: pointer;
}

.gold-button {
  background: #d5a83c;
  border: none;
  font-weight: 700;
  color: #111;
  margin-top: 15px;
}

.outline-button {
  background: transparent;
  border: 1px solid #343b44;
  color: #ddd;
}

.activity-panel {
  margin-top: 28px;
  padding: 30px;
}

.activity {
  display: flex;
  gap: 15px;
  padding: 18px 0;
  border-bottom: 1px solid #252a30;
}

.activity:last-child {
  border-bottom: none;
}

.activity-dot {
  width: 9px;
  height: 9px;
  background: #d4aa42;
  border-radius: 50%;
  margin-top: 5px;
}

.activity p {
  color: #88909a;
  font-size: 12px;
  margin: 6px 0;
}

.activity span {
  color: #5f6872;
  font-size: 10px;
}


/* PAGE HEADINGS */

.page-title {
  margin-bottom: 35px;
}

.page-title h2,
.page-heading h2 {
  font-size: 30px;
  font-weight: 500;
  margin: 0 0 10px;
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 25px;
}


/* HOTELS */

.hotel-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.hotel-card {
  background: #11151a;
  border: 1px solid #2b3139;
  border-radius: 17px;
  overflow: hidden;
}

.hotel-card img {
  width: 100%;
  height: 190px;
  object-fit: cover;
  display: block;
}

.hotel-info {
  padding: 22px;
  display: flex;
  justify-content: space-between;
}

.status {
  color: #70bd9a;
  font-size: 10px;
}

.hotel-info h2 {
  margin: 12px 0 8px;
  font-size: 20px;
}

.hotel-info p {
  color: #858d96;
  font-size: 12px;
}

.hotel-rating {
  color: #e4b744;
  font-size: 13px;
}

.hotel-bottom {
  border-top: 1px solid #282e35;
  padding: 18px 22px;
  display: flex;
  justify-content: space-between;
  color: #858d96;
  font-size: 11px;
}

.hotel-bottom strong {
  color: #e2b64a;
}

.hotel-bottom small {
  color: #777f89;
  font-weight: normal;
}

.map-section {
  margin-top: 35px;
  background: #11151a;
  border: 1px solid #2b3139;
  border-radius: 17px;
  padding: 28px;
}

.map-container {
  height: 430px;
  border-radius: 13px;
  overflow: hidden;
  border: 1px solid #303640;
}

.map-container iframe {
  width: 100%;
  height: 100%;
  border: 0;
}


/* TABLE */

.table-panel {
  overflow: hidden;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th,
td {
  padding: 20px;
  text-align: left;
  border-bottom: 1px solid #282e35;
}

th {
  color: #737c87;
  font-size: 10px;
  letter-spacing: 2px;
}

td {
  color: #d4d7db;
  font-size: 13px;
}

.confirmed {
  color: #70c29c;
}

.pending {
  color: #e2b64a;
}


/* GUESTS */

.guest-grid,
.staff-grid,
.room-grid,
.analytics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.guest-card,
.staff-card {
  padding: 24px;
  display: flex;
  align-items: center;
  gap: 17px;
}

.guest-card h3,
.staff-card h3 {
  margin: 0 0 7px;
}

.guest-card p,
.staff-card p {
  margin: 0 0 6px;
  color: #858d96;
  font-size: 12px;
}

.guest-card span {
  color: #c9a03b;
  font-size: 11px;
}


/* ANALYTICS */

.analytics-card {
  padding: 30px;
  min-height: 280px;
}

.analytics-card > p {
  color: #858d96;
}

.analytics-card h2 {
  font-size: 36px;
  font-weight: 500;
}

.fake-chart {
  height: 130px;
  display: flex;
  align-items: end;
  gap: 12px;
  margin-top: 35px;
}

.fake-chart div {
  flex: 1;
  background: #c99c35;
  border-radius: 5px 5px 0 0;
}

.big-progress {
  margin: 35px 0;
  height: 15px;
}


/* ROOMS */

.room-card {
  padding: 22px;
  display: flex;
  align-items: center;
  gap: 17px;
}

.room-icon {
  font-size: 25px;
}

.room-card h3 {
  margin: 0 0 5px;
}

.room-card p {
  color: #858d96;
  font-size: 11px;
  margin: 0;
}

.room-status {
  margin-left: auto;
  color: #71bf9b;
  font-size: 11px;
}


/* STAFF */

.staff-active {
  color: #6db993;
  font-size: 11px;
}

/* ---------------- STAYSPHERE RECOMMENDATION ---------------- */

.recommendation-header {
  margin-bottom: 25px;
}

.recommendation-header h2 {
  font-size: 32px;
  font-weight: 500;
  margin: 0 0 10px;
}

.recommendation-header p:last-child {
  color: #78818c;
  max-width: 750px;
  line-height: 1.7;
}

/* SEARCH */

.search-panel {
  background: linear-gradient(135deg, #17191c, #11151a);
  border: 1px solid #343a42;
  border-radius: 18px;
  padding: 25px;
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 20px;
}

.search-title {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 260px;
}

.search-title > span {
  width: 45px;
  height: 45px;
  border-radius: 12px;
  background: #29251c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.search-title strong {
  display: block;
  margin-bottom: 5px;
}

.search-title small {
  color: #78818c;
}

.destination-select {
  flex: 1;
  min-width: 220px;
  background: #0c0f13;
  color: white;
  border: 1px solid #3a4048;
  border-radius: 10px;
  padding: 14px 16px;
  font-size: 14px;
  outline: none;
}

.destination-select:focus {
  border-color: #d5a83c;
}

.search-button {
  margin: 0;
  white-space: nowrap;
}

/* FILTERS */

.filter-panel {
  background: #11151a;
  border: 1px solid #292f37;
  border-radius: 17px;
  padding: 25px;
  margin-bottom: 28px;
}

.filter-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.filter-heading h3 {
  margin: 0;
  font-size: 20px;
  font-weight: 500;
}

.filter-heading .section-label {
  margin-bottom: 7px;
}

.clear-filters {
  background: transparent;
  border: 1px solid #343b44;
  color: #9ba2aa;
  border-radius: 8px;
  padding: 8px 13px;
  font-size: 11px;
}

.clear-filters:hover {
  color: #e2b64a;
  border-color: #e2b64a;
}

.filters-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.filter-box {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.filter-box label {
  color: #8d959e;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.filter-box select {
  width: 100%;
  background: #0c0f13;
  border: 1px solid #303640;
  color: #ddd;
  border-radius: 9px;
  padding: 12px;
  outline: none;
}

.filter-box select:focus {
  border-color: #d5a83c;
}

.availability-filter {
  grid-column: span 4;
  padding-top: 8px;
}

.availability-filter label {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #aaa;
  font-size: 12px;
  cursor: pointer;
}

.availability-filter input {
  accent-color: #d5a83c;
  width: 16px;
  height: 16px;
}

/* RESULTS */

.results-layout {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 25px;
  align-items: start;
}

.results-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 18px;
}

.results-heading h2 {
  margin: 0;
  font-size: 26px;
  font-weight: 500;
}

.result-count {
  color: #858d96;
  font-size: 12px;
}

.recommendation-card {
  display: flex;
  background: #11151a;
  border: 1px solid #292f37;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 16px;
  cursor: pointer;
  transition: 0.2s ease;
}

.recommendation-card:hover {
  border-color: #9b7829;
  transform: translateY(-2px);
}

.recommendation-card.selected-hotel {
  border-color: #d5a83c;
  box-shadow: 0 0 0 1px #d5a83c;
}

.recommendation-card > img {
  width: 190px;
  min-width: 190px;
  height: 245px;
  object-fit: cover;
}

.recommendation-info {
  padding: 20px;
  flex: 1;
}

.recommendation-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.recommendation-top h3 {
  margin: 8px 0 6px;
  font-size: 20px;
}

.best-match {
  display: inline-block;
  background: #302719;
  color: #e2b64a;
  padding: 5px 8px;
  border-radius: 5px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.hotel-location {
  color: #858d96;
  font-size: 11px;
  margin: 0;
}

.match-score {
  min-width: 62px;
  height: 62px;
  border: 1px solid #8e6e28;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #e2b64a;
}

.match-score strong {
  font-size: 17px;
}

.match-score span {
  font-size: 8px;
  color: #9299a1;
  text-transform: uppercase;
}

.recommendation-details {
  display: flex;
  gap: 25px;
  border-top: 1px solid #282e35;
  border-bottom: 1px solid #282e35;
  margin-top: 17px;
  padding: 14px 0;
}

.recommendation-details > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.detail-label {
  color: #626b75;
  font-size: 8px;
  letter-spacing: 1px;
}

.recommendation-details strong {
  color: #ddd;
  font-size: 12px;
}

.recommendation-details small {
  color: #777f89;
  font-size: 9px;
}

.amenity-list {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 13px;
}

.amenity-list span {
  background: #1b1f24;
  border: 1px solid #2d333a;
  color: #9da4ac;
  padding: 5px 7px;
  border-radius: 5px;
  font-size: 9px;
}

.recommendation-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14px;
}

.available-text {
  color: #6fba94;
  font-size: 10px;
}

.view-hotel-button {
  background: transparent;
  border: 1px solid #3a4149;
  color: #d7d7d7;
  padding: 8px 11px;
  border-radius: 7px;
  font-size: 10px;
}

.view-hotel-button:hover {
  border-color: #d5a83c;
  color: #e2b64a;
}

/* MAP */

.recommendation-map {
  background: #11151a;
  border: 1px solid #292f37;
  border-radius: 17px;
  overflow: hidden;
  position: sticky;
  top: 25px;
}

.map-heading {
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.map-heading h2 {
  margin: 0 0 5px;
  font-size: 20px;
  font-weight: 500;
}

.map-heading p:last-child {
  margin: 0;
  color: #858d96;
  font-size: 11px;
}

.map-live {
  color: #6fba94;
  font-size: 9px;
  letter-spacing: 1px;
}

.recommendation-map iframe {
  display: block;
  width: 100%;
  height: 480px;
  border: 0;
}

.map-hotel-info {
  padding: 15px 20px;
  border-top: 1px solid #292f37;
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.map-hotel-info strong {
  font-size: 12px;
}

.map-hotel-info span {
  color: #9a8a62;
  font-size: 10px;
}

.empty-map {
  height: 480px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #727b85;
}

.no-results {
  background: #11151a;
  border: 1px solid #292f37;
  border-radius: 17px;
  text-align: center;
  padding: 60px 20px;
}

.no-results div {
  font-size: 40px;
}

.no-results h3 {
  margin: 15px 0 7px;
}
.no-results p {
  color: #78818c;
  font-size: 12px;
}
/* RESPONSIVE */

@media (max-width: 1100px) {
  .sidebar {
    width: 240px;
  }

  .main {
    margin-left: 240px;
    width: calc(100% - 240px);
  }

  .stats-grid,
  .hotel-list {
    grid-template-columns: repeat(2, 1fr);
  }

  .content {
    padding: 35px;
  }
}

@media (max-width: 750px) {
  .sidebar {
    position: relative;
    width: 100%;
    min-height: auto;
  }

  .main {
    margin-left: 0;
    width: 100%;
  }

  .app {
    display: block;
  }

  .stats-grid,
  .hotel-list,
  .dashboard-grid,
  .guest-grid,
  .staff-grid,
  .room-grid,
  .analytics-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    padding: 25px;
  }

  .content {
    padding: 25px;
  }
}
  /* ================= USER BOOKING PAGE ================= */

.user-booking-page {
  min-height: 100vh;
  background: #0b0b0d;
  color: #f5f5f5;
}

.user-navbar {
  height: 76px;
  padding: 0 55px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #29292d;
  background: #111114;
}

.user-brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.user-logo {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c9a227;
  color: #111;
  font-size: 22px;
  font-weight: 800;
}

.user-brand h2 {
  margin: 0;
  font-size: 20px;
}

.user-brand span {
  font-size: 9px;
  letter-spacing: 2px;
  color: #999;
}

.user-logout {
  background: transparent;
  border: 1px solid #444;
  color: #ddd;
  padding: 9px 20px;
  border-radius: 8px;
  cursor: pointer;
}

.user-main {
  max-width: 1100px;
  margin: auto;
  padding: 60px 30px 50px;
}

.user-hero {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 38px;
}

.user-label {
  color: #c9a227;
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 700;
  margin-bottom: 10px;
}

.user-hero h1 {
  font-size: 48px;
  margin: 0;
  line-height: 1.1;
}

.user-hero h1 span {
  color: #c9a227;
}

.user-hero > p:last-child {
  color: #9b9b9f;
  line-height: 1.7;
  margin-top: 16px;
}

.hotel-search-card {
  background: #151518;
  border: 1px solid #29292e;
  border-radius: 18px;
  padding: 35px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
}

.search-card-heading {
  margin-bottom: 28px;
}

.search-card-heading h2 {
  margin: 0;
  font-size: 25px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.form-group label,
.amenities-heading label {
  color: #eee;
  font-size: 13px;
  font-weight: 600;
}

.form-group select {
  height: 50px;
  padding: 0 15px;
  border-radius: 9px;
  border: 1px solid #38383d;
  background: #0f0f12;
  color: #eee;
  font-size: 14px;
  outline: none;
}

.form-group select:focus {
  border-color: #c9a227;
}

.destination-group {
  margin-bottom: 25px;
}

.filter-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 30px;
}

.amenities-section {
  border-top: 1px solid #29292e;
  padding-top: 25px;
}

.amenities-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.amenities-heading span {
  color: #777;
  font-size: 12px;
}

.amenities-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
}

.amenity-card {
  min-height: 85px;
  border: 1px solid #34343a;
  border-radius: 10px;
  background: #101013;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  cursor: pointer;
  transition: 0.2s;
}

.amenity-card:hover {
  border-color: #c9a227;
  transform: translateY(-2px);
}

.amenity-card input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.amenity-card {
  position: relative;
}

.amenity-card:has(input:checked) {
  border-color: #c9a227;
  background: #211d0e;
  box-shadow: 0 0 0 1px #c9a227;
}

.amenity-card:has(input:checked) strong {
  color: #c9a227;
}

.amenity-card:has(input:checked)::after {
  content: "✓";
  position: absolute;
  top: 7px;
  right: 8px;
  color: #c9a227;
  font-size: 13px;
  font-weight: bold;
}

.amenity-card span {
  font-size: 20px;
}

.amenity-card strong {
  font-size: 12px;
  color: #bbb;
}

.find-stay-button {
  width: 100%;
  height: 55px;
  margin-top: 30px;
  border: none;
  border-radius: 10px;
  background: #c9a227;
  color: #111;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
  transition: 0.2s;
}

.find-stay-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.08);
}

.user-benefits {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 30px;
}

.user-benefits > div {
  display: flex;
  gap: 13px;
  padding: 18px;
  border: 1px solid #29292e;
  border-radius: 12px;
  background: #111114;
}

.user-benefits > div > span {
  color: #c9a227;
  font-size: 22px;
}

.user-benefits strong {
  font-size: 13px;
}

.user-benefits p {
  margin: 5px 0 0;
  color: #777;
  font-size: 11px;
}

@media (max-width: 800px) {

  .filter-row {
    grid-template-columns: 1fr;
  }

  .amenities-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .user-benefits {
    grid-template-columns: 1fr;
  }

  .user-hero h1 {
    font-size: 38px;
  }

  .user-navbar {
    padding: 0 20px;
  }
}
`;

export default App;